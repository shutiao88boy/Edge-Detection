   <property name="styleSheet">
    <string notr="true">#centralwidget {
    background: #eef2f7;
}
QGroupBox {
    background: #ffffff;
    border: 1px solid #d9e1ec;
    border-radius: 8px;
    margin-top: 20px;
    font: 600 15px "Microsoft YaHei";
    color: #27364a;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 8px;
    background: #eef2f7;
}
QTextEdit {
    background: #f8fafc;
    border: 1px solid #dfe7f1;
    border-radius: 6px;
    padding: 14px;
    font: 12px "Consolas", "Microsoft YaHei";
    color: #2f3a4a;
}
QLabel {
    font: 12px "Microsoft YaHei";
}
QPushButton {
    color: white;
    border: none;
    border-radius: 6px;
    font: 600 14px "Microsoft YaHei";
}
QPushButton:pressed {
    padding-top: 1px;
}</string>
